  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring",
        "string.quoted.double.block.python",
        "string.quoted.single.block.python"
      ],
      "settings": {
        "foreground": "#878580",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#66800B"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#6F6E69"
      }
    },
    {
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.other.import"
      ],
      "settings": {
        "foreground": "#AF3029"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#BC5215"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#24837B"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#5E409D"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#AD8301"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#AD8301"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#100F0F"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#100F0F"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#205EA6"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.parameter.function.language.special.self"
      ],
      "settings": {
        "foreground": "#A02F6F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#205EA6"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#AD8301"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#6F6E69"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.character.format.placeholder"
      ],
      "settings": {
        "foreground": "#A02F6F"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#24837B"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#AF3029"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#BC5215",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#BC5215",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#205EA6"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#24837B"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#878580",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.list punctuation.definition.list.begin"
      ],
      "settings": {
        "foreground": "#66800B"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#66800B"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#AF3029"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#AD8301"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#100F0F",
    "parameter": "#100F0F",
    "property": "#205EA6",
    "function": "#BC5215",
    "method": "#BC5215",
    "macro": "#AD8301",
    "type": "#AD8301",
    "class": "#AD8301",
    "interface": "#AD8301",
    "enum": "#AD8301",
    "struct": "#AD8301",
    "typeParameter": "#AD8301",
    "namespace": "#AD8301",
    "enumMember": "#AD8301",
    "variable.readonly": "#AD8301",
    "decorator": "#BC5215",
    "keyword": "#66800B",
    "number": "#5E409D",
    "string": "#24837B",
    "selfParameter": {
      "foreground": "#A02F6F",
      "italic": true
    }
  }
